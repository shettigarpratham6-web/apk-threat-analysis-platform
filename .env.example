# Copy to .env and fill in values for local development.

ENV=dev
API_KEY=
VITE_API_KEY=
CORS_ORIGINS=http://localhost:5173
LLM_ENABLED=false

# Optional VirusTotal API Key for signature check and domain reputation enrichment
VIRUSTOTAL_API_KEY=

# Optional AbuseIPDB API Key for IP address reputation enrichment
ABUSEIPDB_API_KEY=

# Android Emulator Sandbox Configuration
ANDROID_EMULATOR_PATH=
AVD_NAME=threat_sandbox_avd
SNAPSHOT_NAME=clean_state
MITMPROXY_HOST=127.0.0.1
MITMPROXY_PORT=8080

# Frontend & Backend Base URL Configuration
API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# OpenRouter API Key for optional LLM narrative
OPENROUTER_API_KEY=
