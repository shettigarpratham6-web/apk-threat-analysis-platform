# Copy to .env and fill in values for local development.
# Optional VirusTotal API Key for signature check and domain reputation enrichment
VT_API_KEY=
VIRUSTOTAL_API_KEY=

# Optional AbuseIPDB API Key for IP address reputation enrichment
ABUSEIPDB_API_KEY=


# Android Emulator Sandbox Configuration
# Path to Android SDK emulator binary (e.g. C:\Users\<user>\AppData\Local\Android\Sdk\emulator\emulator.exe)
ANDROID_EMULATOR_PATH=
# AVD Name created for sandbox execution
AVD_NAME=threat_sandbox_avd
# Clean snapshot name for environment resets
SNAPSHOT_NAME=clean_state

# Frontend & Backend Base URL Configuration
API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# OpenRouter API Key — enables LLM threat narrative (Llama 3.3 70B) and
# suspicious code de-obfuscation (Qwen 2.5 Coder 32B) features.
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
